{
  "profile": "besquare-youtube-4k-v2",
  "video": {
    "width": 3840,
    "height": 2160,
    "colorspace": "bt709",
    "pixel_format": "yuv420p",
    "max_duration_drift_seconds": 0.25
  },
  "audio": {
    "target_lufs": -14.0,
    "target_true_peak_dbtp": -2.0,
    "maximum_true_peak_dbtp": -1.0,
    "sample_rate": 48000,
    "channels": 2
  },
  "qa": {
    "black_min_seconds": 0.75,
    "freeze_min_seconds": 2.0,
    "repeat_seconds": 5,
    "source_event_tolerance_seconds": 1.5
  },
  "autonomy": {
    "max_auto_repair_attempts": 3,
    "auto_retry_runtime_failures": 3,
    "audio_repair_initial_true_peak_dbtp": -2.5,
    "audio_repair_floor_true_peak_dbtp": -4.0
  },
  "creative": {
    "default_mode": "explainer",
    "talking_head_refresh_target_seconds": 25,
    "explainer_max_uninterrupted_talking_head_seconds": 35,
    "podcast_cutaways": false,
    "creative_qa_required": true,
    "unsourced_claim_graphics_prohibited": true
  },
  "captions": {
    "safe_area": "bottom",
    "maximum_lines": 2,
    "maximum_words_per_line": 7,
    "podcast_default_words_per_caption": 12,
    "podcast_speaker_detection": "fixed-left-right-mouth-motion",
    "speaker_assignment_manual_review_required_when_low_confidence": true
  },
  "editorial": {
    "preserve_complete_frame": true,
    "abrupt_zooms_prohibited": true,
    "decorative_graphs_prohibited": true,
    "source_labels_required": true,
    "political_neutrality_required": true,
    "candidate_interviews_essentially_complete": true,
    "protected_terms": ["Wasaga Beach", "BeSquare by pSquare"]
  }
}
