#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  echo "This helper must run as root via sudo." >&2
  exit 1
fi

case "$(hostname -s)" in
  media-server|core-01) ;;
  *) echo "This helper is restricted to core-01/media-server." >&2; exit 2 ;;
esac

ACTION="${1:-}"
CADDYFILE="/opt/docker/compose/caddy/Caddyfile"
BACKUPS="/opt/docker/compose/caddy/config-backups"
NEW_UPSTREAM="http://192.168.0.88:8787/"
MARKER="osho-kpis"

require_files() {
  [[ -f "$CADDYFILE" ]] || { echo "Missing $CADDYFILE" >&2; exit 3; }
  command -v docker >/dev/null
  command -v curl >/dev/null
  command -v python3 >/dev/null
}

fetch_contains() {
  local url="$1" marker="$2" host_header="${3:-}" tmp rc
  tmp="$(mktemp)"
  if [[ -n "$host_header" ]]; then
    curl -fsS --max-time 6 -H "Host: $host_header" "$url" -o "$tmp" || rc=$?
  else
    curl -fsS --max-time 6 "$url" -o "$tmp" || rc=$?
  fi
  rc="${rc:-0}"
  if [[ "$rc" -eq 0 ]] && grep -Fq "$marker" "$tmp"; then
    rm -f "$tmp"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

route_probe() {
  local tmp rc
  tmp="$(mktemp)"
  curl -fsS --max-time 6 -H 'Host: dashboard.home.arpa' http://127.0.0.1/ -o "$tmp" || rc=$?
  rc="${rc:-0}"
  if [[ "$rc" -eq 0 ]]; then
    echo "DASHBOARD_HTTP=ok"
    if grep -Fq "$MARKER" "$tmp"; then
      echo "DASHBOARD_PRODUCT=p2-command-center"
    elif grep -qi 'homepage' "$tmp"; then
      echo "DASHBOARD_PRODUCT=homepage"
    else
      echo "DASHBOARD_PRODUCT=other"
    fi
  else
    echo "DASHBOARD_HTTP=unavailable"
    echo "DASHBOARD_PRODUCT=unknown"
  fi
  rm -f "$tmp"
}

status() {
  require_files
  echo "HOST=$(hostname -s)"
  echo "NEW_UPSTREAM=$NEW_UPSTREAM"
  echo "=== DASHBOARD ROUTES ==="
  grep -A3 -B1 -E 'dashboard\.home\.arpa|homepage\.home\.arpa' "$CADDYFILE" || true
  echo "=== NEW APP ==="
  if fetch_contains "$NEW_UPSTREAM" "$MARKER"; then
    echo "P2_APP=ready"
  else
    echo "P2_APP=unavailable-or-wrong-content"
  fi
  echo "=== LIVE ROUTE ==="
  route_probe
}

validate_and_reload() {
  if ! docker exec caddy caddy validate --config /etc/caddy/Caddyfile >/dev/null; then
    echo "Caddy validation failed" >&2
    return 1
  fi
  docker exec caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null
  sleep 1
}

activate_custom() {
  require_files
  fetch_contains "$NEW_UPSTREAM" "$MARKER" || {
    echo "Refusing: P2 Command Center is not healthy on compute-02" >&2
    exit 4
  }

  local stamp backup
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUPS"
  backup="$BACKUPS/Caddyfile-$stamp-before-p2-dashboard"
  cp -a "$CADDYFILE" "$backup"

  python3 - "$CADDYFILE" <<'PY'
from pathlib import Path
import re, sys
p=Path(sys.argv[1])
text=p.read_text()
block='''http://dashboard.home.arpa {
    reverse_proxy 192.168.0.88:8787
}

http://homepage.home.arpa {
    reverse_proxy 127.0.0.1:3000
}'''
pat=re.compile(r'http://dashboard\.home\.arpa\s*\{.*?\}', re.S)
if not pat.search(text):
    raise SystemExit('dashboard.home.arpa block not found')
text=pat.sub(block, text, count=1)
first=text.find('http://homepage.home.arpa')
if first >= 0:
    second=text.find('http://homepage.home.arpa', first+1)
    if second >= 0:
        raise SystemExit('duplicate homepage.home.arpa route detected')
p.write_text(text)
PY

  if ! validate_and_reload; then
    cp -a "$backup" "$CADDYFILE"
    docker exec caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null || true
    exit 5
  fi

  if ! fetch_contains http://127.0.0.1/ "$MARKER" dashboard.home.arpa; then
    echo "Post-change health check failed; rolling back" >&2
    cp -a "$backup" "$CADDYFILE"
    docker exec caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null || true
    exit 6
  fi

  echo "P2_DASHBOARD_ROUTE=active"
  echo "BACKUP=$backup"
  status
}

restore_homepage() {
  require_files
  local stamp backup
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUPS"
  backup="$BACKUPS/Caddyfile-$stamp-before-homepage-restore"
  cp -a "$CADDYFILE" "$backup"

  python3 - "$CADDYFILE" <<'PY'
from pathlib import Path
import re, sys
p=Path(sys.argv[1]); text=p.read_text()
pat=re.compile(r'http://dashboard\.home\.arpa\s*\{.*?\}', re.S)
if not pat.search(text): raise SystemExit('dashboard.home.arpa block not found')
text=pat.sub('''http://dashboard.home.arpa {
    reverse_proxy 127.0.0.1:3000
}''', text, count=1)
text=re.sub(r'\n*http://homepage\.home\.arpa\s*\{.*?\}\n*', '\n\n', text, count=1, flags=re.S)
p.write_text(text)
PY

  if ! validate_and_reload; then
    cp -a "$backup" "$CADDYFILE"
    docker exec caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null || true
    exit 5
  fi
  echo "P2_DASHBOARD_ROUTE=homepage-restored"
  status
}

case "$ACTION" in
  status) status ;;
  activate-custom) activate_custom ;;
  restore-homepage) restore_homepage ;;
  *) echo "Allowed actions: status | activate-custom | restore-homepage" >&2; exit 2 ;;
esac
