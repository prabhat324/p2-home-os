#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
HOMEPAGE_DIR="/opt/docker/compose/homepage"
CONFIG="$HOMEPAGE_DIR/config/services.yaml"
RAW_FILE="https://raw.githubusercontent.com/prabhat324/p2-home-os/master/services/home-dashboard/services.yaml"

log() {
    printf '[p2ops-home-dashboard] %s\n' "$*"
}

status() {
    echo "HOST=$(hostname)"
    echo "CONFIG=$CONFIG"
    echo "CONFIG_PRESENT=$([[ -f "$CONFIG" ]] && echo yes || echo no)"
    echo "HOMEPAGE_HTTP=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:3000/ 2>/dev/null || echo unavailable)"
    echo "HOMEPAGE_CONTAINER=$(docker inspect -f '{{.State.Status}}' homepage 2>/dev/null || echo unavailable)"
}

deploy_master() {
    command -v curl >/dev/null
    command -v docker >/dev/null
    command -v python3 >/dev/null
    [[ -d "$HOMEPAGE_DIR/config" ]]
    [[ -f "$CONFIG" ]]

    local tmp stamp backup
    tmp="$(mktemp -d)"
    trap "rm -rf -- '$tmp'" EXIT

    log "downloading source-controlled Homepage services from master"
    curl -fsSL "$RAW_FILE" -o "$tmp/services.yaml"

    python3 - "$tmp/services.yaml" <<'PY'
import sys
try:
    import yaml
except Exception as exc:
    raise SystemExit(f"PyYAML is required for validation: {exc}")
with open(sys.argv[1], encoding='utf-8') as fh:
    data = yaml.safe_load(fh)
if not isinstance(data, list) or not data:
    raise SystemExit('Homepage services.yaml must contain a non-empty list')
print(f'Validated {len(data)} Homepage groups')
PY

    stamp="$(date +%Y%m%d-%H%M%S)"
    backup="$HOMEPAGE_DIR/config-backups/config-${stamp}-control-plane"
    mkdir -p "$backup"
    cp -a "$CONFIG" "$backup/services.yaml"
    chown -R psquare:psquare "$backup"
    log "backup created at $backup"

    install -o psquare -g psquare -m 0644 "$tmp/services.yaml" "$CONFIG"

    if ! docker restart homepage >/dev/null; then
        log "restart failed; restoring previous config"
        install -o psquare -g psquare -m 0644 "$backup/services.yaml" "$CONFIG"
        docker restart homepage >/dev/null || true
        exit 1
    fi

    sleep 3
    if ! curl -fsS --max-time 8 http://127.0.0.1:3000/ >/dev/null; then
        log "Homepage health check failed; rolling back"
        install -o psquare -g psquare -m 0644 "$backup/services.yaml" "$CONFIG"
        docker restart homepage >/dev/null || true
        exit 1
    fi

    log "Homepage resource deployment complete"
    status
}

case "$ACTION" in
    status) status ;;
    deploy-master) deploy_master ;;
    *)
        echo "Allowed actions: status | deploy-master" >&2
        exit 2
        ;;
esac
